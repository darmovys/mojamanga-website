generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================= USER & AUTH =================

model User {
  id              String     @id @default(cuid(2))
  name            String
  email           String
  emailVerified   Boolean    @default(false) @map("email_verified")
  image           String?    @map("cover_url")
  backgroundUrl   String?    @map("background_url")
  role            UserRole   @default(USER)
  username        String     @unique
  displayUsername String     @map("display_username")
  status          UserStatus @default(NORMAL)

  sessions Session[]
  accounts Account[]

  createdTeams            Team[]                   @relation("TeamCreator")
  teamMemberships         TeamMember[]
  uploadedChapters        Chapter[]
  comments                Comment[]
  likes                   Like[]
  dislikes                Dislike[]
  ratings                 Rating[]
  bookmarksFolders        BookmarkFolder[]
  bookmarks               Bookmark[]
  publishingSubscriptions PublishingSubscription[]
  news                    News[]
  notifications           Notification[]
  titleAddings            Title[]
  titleEditProposals      TitleEditProposal[]      @relation("ProposalSubmitter")
  titleEditReviews        TitleEditProposal[]      @relation("ProposalReviewer")
  titleEditions           TitleVersion[]
  commentComplaints       CommentComplaint[]
  proposedPeople          Person[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime @map("expires_at")
  token     String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ================= TEAMS =================

model Team {
  id            String     @id @default(cuid(2))
  name          String
  coverUrl      String?    @map("cover_url")
  backgroundUrl String?    @map("background_url")
  description   String?
  status        TeamStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason")

  creatorId String @map("creator_id")
  creator   User   @relation("TeamCreator", fields: [creatorId], references: [id])

  members            TeamMember[]
  links              TeamLink[]
  publishingVersions PublishingVersion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

model TeamLink {
  id   String   @id @default(cuid(2))
  type LinkType
  url  String

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_links")
}

model TeamMember {
  id                 String     @id @default(cuid(2))
  userId             String     @map("user_id")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId             String     @map("team_id")
  team               Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roles              TeamRole[] @default([TRANSLATOR])
  canPublishChapters Boolean    @default(false) @map("can_publish_chapters")
  canEditTeamInfo    Boolean    @default(false) @map("can_edit_team_info")
  canDeleteChapters  Boolean    @default(false) @map("can_delete_chapters")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, teamId]) // Юзер не може бути двічі в одній команді
  @@map("team_members")
}

// ================= CONTENT: TITLES =================

model Title {
  id                 String              @id @default(cuid(2))
  approvalStatus     TitleApprovalStatus @default(PENDING) @map("approval_status")
  moderationFeedback Json?               @map("moderation_feedback")

  proposedByUserId String @map("proposed_by_user_id")
  proposedByUser   User   @relation(fields: [proposedByUserId], references: [id])

  currentVersionId String?        @unique @map("current_version_id")
  currentVersion   TitleVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         TitleVersion[] @relation("TitleHistory")

  publishers PublishingVersion[]
  comments   Comment[]
  ratings    Rating[]
  proposals  TitleEditProposal[]
  bookmarks  Bookmark[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("titles")
}

model TitleVersion {
  id      String @id @default(cuid(2))
  titleId String @map("title_id")
  title   Title  @relation("TitleHistory", fields: [titleId], references: [id], onDelete: Cascade)

  editorId String @map("editor_id")
  editor   User   @relation(fields: [editorId], references: [id])

  // Версіоновані поля
  nameUkr           String            @map("name_ukr")
  nameEng           String            @map("name_eng")
  alternativeNames  AlternativeName[]
  description       String?
  coverUrl          String            @map("cover_url")
  backgroundUrl     String?           @map("background_url")
  releaseYear       Int               @map("release_year")
  type              TitleType
  ageRestriction    AgeRestriction    @map("age_restriction")
  titleStatus       TitleStatus       @map("title_status")
  translationStatus TranslationStatus @map("translation_status")

  sources TitleSource[]
  tags    TitleVersionToTag[]
  genres  TitleVersionToGenre[]
  people  TitleVersionToPerson[]

  proposalId String?            @unique @map("proposal_id")
  proposal   TitleEditProposal? @relation(fields: [proposalId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  // Зворотний зв'язок
  titleAsCurrent Title? @relation("CurrentVersion")

  @@map("title_versions")
}

model TitleSource {
  id  String @id @default(cuid(2))
  url String

  titleId String       @map("title_id")
  title   TitleVersion @relation(fields: [titleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("title_sources")
}

model AlternativeName {
  id             String       @id @default(cuid(2))
  name           String
  titleVersionId String       @map("title_version")
  titleVersion   TitleVersion @relation(fields: [titleVersionId], references: [id], onDelete: Cascade)

  @@index([name])
  @@map("alternative_names")
}

model TitleVersionToPerson {
  role      PersonRole
  versionId String       @map("version_id")
  version   TitleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  personId  String       @map("person_id")
  person    Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([versionId, personId, role])
  @@map("title_version_to_person")
}

model TitleVersionToGenre {
  versionId String       @map("version_id")
  version   TitleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  genreId   String       @map("genre_id")
  genre     Genre        @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([versionId, genreId])
  @@map("title_version_to_genre")
}

model TitleVersionToTag {
  versionId String       @map("version_id")
  version   TitleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tagId     String       @map("tag_id")
  tag       Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([versionId, tagId])
  @@map("title_version_to_tag")
}

model TitleEditProposal {
  id String @id @default(cuid(2))

  userId String @map("user_id")
  user   User   @relation("ProposalSubmitter", fields: [userId], references: [id], onDelete: Restrict)

  reviewerId String? @map("reviewer_id")
  reviewer   User?   @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  titleId String @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id])

  status TitleEditProposalStatus @default(PENDING)

  // --- Поля для зміни (Nullable) ---
  // Якщо поле null - значить його змінювати не пропонують
  proposedNameUkr           String?            @map("proposed_name_ukr")
  proposedNameEng           String?            @map("proposed_name_eng")
  proposedAlternativeNames  Json?              @map("proposed_alternative_names")
  proposedDescription       String?            @map("proposed_description")
  proposedCoverUrl          String?            @map("proposed_cover_url")
  proposedBackgroundUrl     String?            @map("proposed_background_url")
  proposedReleaseYear       Int?               @map("proposed_release_year")
  proposedType              TitleType?         @map("proposed_type")
  proposedAgeRestriction    AgeRestriction?    @map("proposed_age_restriction")
  proposedTitleStatus       TitleStatus?       @map("proposed_title_status")
  proposedTranslationStatus TranslationStatus? @map("proposed_translation_status")
  proposedTags              Json?              @map("proposed_tags")
  proposedGenres            Json?              @map("proposed_genres")
  proposedAuthors           Json?              @map("proposed_authors")
  proposedArtists           Json?              @map("proposed_artists")
  proposedSources           Json?              @map("proposed_sources")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  titleVersion TitleVersion?

  @@map("title_edit_proposals")
}

// ================= METADATA (TAGS, AUTHORS...) =================

model Tag {
  id   String @id @default(cuid(2))
  name String @unique

  titleVersions TitleVersionToTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tags")
}

model Genre {
  id   String @id @default(cuid(2))
  name String @unique

  titleVersions TitleVersionToGenre[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("genres")
}

model Person {
  id                 String                   @id @default(cuid(2))
  nameUkr            String                   @map("name_ukr")
  nameLat            String                   @map("name_lat")
  description        String?
  coverUrl           String?                  @map("cover_url")
  verificationStatus PersonVerificationStatus @default(PENDING) @map("verification_status")
  titles             TitleVersionToPerson[]
  proposedByUserId   String?                  @map("proposed_by_user_id")
  proposedByUser     User?                    @relation(fields: [proposedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([proposedByUserId])
  @@map("people")
}

// ================= PUBLISHING & CHAPTERS =================

model PublishingVersion {
  id      String @id @default(cuid(2))
  teamId  String @map("team_id")
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  titleId String @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  chapters                Chapter[]
  publishingSubscriptions PublishingSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, titleId]) // Одна команда - одна версія перекладу для твору
  @@map("publishing_versions")
}

model Chapter {
  id              String              @id @default(cuid(2))
  name            String?
  volumeNum       Float               @map("volume_num")
  chapterNum      Float               @map("chapter_num")
  approvalStatus  TitleApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason String?             @map("rejection_reason")

  publishingVersionId String            @map("publishing_version_id")
  publishingVersion   PublishingVersion @relation(fields: [publishingVersionId], references: [id], onDelete: Cascade)

  uploaderId String @map("uploader_id")
  uploader   User   @relation(fields: [uploaderId], references: [id])

  pages     Page[]
  bookmarks Bookmark[]
  likes     Like[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([publishingVersionId, volumeNum, chapterNum]) // Унікальність в межах версії команди
  @@map("chapters")
}

model Page {
  id        String  @id @default(cuid(2))
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageNum   Int     @map("page_num")
  pageUrl   String  @map("page_url")

  comments Comment[]

  @@map("pages")
}

// ================= SOCIAL & INTERACTION =================

model Comment {
  id           String  @id @default(cuid(2))
  content      String
  isDeleted    Boolean @default(false) @map("is_deleted")
  isHidden     Boolean @default(false) @map("is_hidden")
  hidingReason String? @map("hiding_reason")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id])

  pageId String? @map("page_id")
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  titleId String? @map("title_id")
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  // Closure Table Relations
  ancestors   CommentClosure[] @relation("Ancestors")
  descendants CommentClosure[] @relation("Descendants")

  likes      Like[]
  dislikes   Dislike[]
  complaints CommentComplaint[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("comments")
}

model CommentClosure {
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  depth        Int

  ancestor   Comment @relation("Ancestors", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Comment @relation("Descendants", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  // Індекси (опціонально, але бажано для Closure Table, якщо будуть складні вибірки)
  @@index([descendantId])
  @@index([ancestorId])
  @@map("comment_closures")
}

model Like {
  id String @id @default(cuid(2))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, commentId]) // Юзер може лайкнути комент лише раз
  @@map("likes")
}

model Dislike {
  id String @id @default(cuid(2))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, commentId])
  @@map("dislikes")
}

model Rating {
  id    String @id @default(cuid(2))
  score Int // 1-10 або 1-5

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  titleId String @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, titleId])
  @@map("ratings")
}

model BookmarkFolder {
  id         String            @id @default(cuid(2))
  name       String
  isSystem   Boolean           @default(false) @map("is_system")
  systemType SystemFolderType? @map("system_type")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookmarks Bookmark[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("bookmark_folders")
}

model Bookmark {
  id String @id @default(cuid(2))

  folderId String         @map("folder_id")
  folder   BookmarkFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  titleId String @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  // Прогрес читання (остання глава)
  lastChapterId String?  @map("last_chapter_id")
  lastChapter   Chapter? @relation(fields: [lastChapterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([folderId, titleId])
  @@map("bookmarks")
}

// ================= SUBSCRIPTIONS (NOTIFICATIONS) =================

model PublishingSubscription {
  id String @id @default(cuid(2))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Підписка йде на конкретний переклад конкретної команди
  publishingVersionId String            @map("publishing_version_id")
  publishingVersion   PublishingVersion @relation(fields: [publishingVersionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // Захист від дублікатів підписок
  @@unique([userId, publishingVersionId])
  @@map("publishing_subscriptions")
}

/**
 * Нижня таблиця підлягає значним змінам в структурі
 * (дивитися "примітки по роботі над сайтом")
 */

model Notification {
  id          String           @id @default(cuid(2))
  type        NotificationType
  isRead      Boolean          @default(false) @map("is_read")
  isImportant Boolean          @default(false) @map("is_important")

  /**
   * Якщо сповіщення важливе, воно не видалятиметься автоматично через деякий час.
   * Користувач може зберігати такі сповіщення
   */

  receiverId String @map("reciever_id")
  receiver   User   @relation(fields: [receiverId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

// ================= MISC =================

/**
 * Потенційна таблиця на видалення
 * (Якщо до новин не буде прикріплена система коментарів)
 */

model News {
  id      String @id @default(cuid(2))
  title   String
  content String
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model CommentComplaint {
  id String @id @default(cuid(2))

  reporterId String @map("reporter_id")
  reporter   User   @relation(fields: [reporterId], references: [id])

  commentId String  @map("comment_id")
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reason  ReportReason
  details String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Захист від спаму: один юзер може поскаржитися на один коментар лише раз
  @@unique([reporterId, commentId])
  @@map("comment_complaints")
}

// ================= ENUMS =================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  NORMAL
  RESTRICTED
  BANNED
}

enum TeamStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum LinkType {
  DISCORD
  INSTAGRAM
  TELEGRAM
  TIKTOK
  FACEBOOK
  X
  MONOBANK
  BUYMEACOFFEE
  DONATELLO
  SITE
}

enum TeamRole {
  ADMIN
  TRANSLATOR
  CLEANER
  TYPER
}

enum PersonRole {
  AUTHOR
  ARTIST
}

enum TitleEditProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TitleType {
  MANGA
  MANHWA
  MANHUA
  MALOPUS
  COMIC
  WEBCOMIC
}

enum TitleStatus {
  ONGOING
  ENDED
  PAUSED
  LICENSED
  ANNOUNCEMENT
}

enum TranslationStatus {
  ONGOING
  ENDED
  FREEZED
  DROPPED
}

enum AgeRestriction {
  NO_RESTRICTION
  SIX_PLUS
  TWELVE_PLUS
  SIXTEEN_PLUS
  EIGHTEEN_PLUS
}

enum NotificationType {
  NEW_CHAPTER
  COMMENT_REPLY
  WORK_APPROVED
  WORK_REJECTED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  USER_BANNED
}

enum ReportReason {
  USER_OFFENCE // Образи
  SPOILERS // Спойлери
  AD // Реклама
  SLURS // Нецензурна лексика / Мова ворожнечі
  PROHIBITED_CONTENT // Заборонений контент 18+ і т.д.
  CONFLICTS // Провокація конфліктів
  OFFTOPIC // Не по темі
  OTHER
}

enum TitleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SystemFolderType {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

enum PersonVerificationStatus {
  PENDING
  APPROVED
}
